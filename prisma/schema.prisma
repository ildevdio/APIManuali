generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (substituem VARCHAR + CHECK ... IN (...)) ----------

enum StatusCuradoria {
  pendente
  aprovado
  reprovado
}

enum StatusPedido {
  pendente
  pago
  enviado
  entregue
  cancelado
}

enum MetodoPagamento {
  pix
  cartaoCredito
  cartaoDebito
  boleto
}

enum StatusPagamento {
  pendente
  aprovado
  recusado
  estornado
}

enum StatusEntrega {
  aguardando
  emTransporte
  entregue
  extraviado
}

// ---------- Usuário e suas 2 versões ----------

model Usuario {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String @db.VarChar(150)
  email     String @unique @db.VarChar(255)
  senhaHash String @map("senha_hash") @db.VarChar(255)

  artesao    Artesao?
  consumidor Consumidor?

  @@map("usuario")
}

model Artesao {
  usuarioId       String          @id @map("usuario_id") @db.Uuid
  cpfCnpj         String          @unique @map("cpf_cnpj") @db.VarChar(14)
  historia        String?
  tecnica         String?         @db.VarChar(100)
  municipio       String          @db.VarChar(100)
  statusCuradoria StatusCuradoria @default(pendente) @map("status_curadoria")

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produtos   Produto[]
  avaliacoes Avaliacao[]

  @@map("artesao")
}

model Consumidor {
  usuarioId       String  @id @map("usuario_id") @db.Uuid
  enderecoEntrega String? @map("endereco_entrega") @db.VarChar(300)

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pedidos    Pedido[]
  avaliacoes Avaliacao[]

  @@map("consumidor")
}

// ---------- Catálogo ----------

model Categoria {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome String @unique @db.VarChar(80)

  produtos Produto[]

  @@map("categoria")
}

model Produto {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artesaoId      String  @map("artesao_id") @db.Uuid
  categoriaId    String  @map("categoria_id") @db.Uuid
  nome           String  @db.VarChar(150)
  descricao      String?
  preco          Decimal @db.Decimal(10, 2)
  disponivel     Boolean @default(true)
  tecnica        String? @db.VarChar(100)
  materialOrigem String? @map("material_origem") @db.VarChar(150)

  artesao   Artesao      @relation(fields: [artesaoId], references: [usuarioId], onDelete: Restrict)
  categoria Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  itens     ItemPedido[]

  @@index([artesaoId], map: "idx_produto_artesao")
  @@index([categoriaId], map: "idx_produto_categoria")
  @@map("produto")
}

// ---------- Pedido e componentes ----------

model Pedido {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumidorId  String       @map("consumidor_id") @db.Uuid
  dataHora      DateTime     @default(now()) @map("data_hora") @db.Timestamptz(6)
  status        StatusPedido @default(pendente)
  valorTotal    Decimal      @default(0) @map("valor_total") @db.Decimal(12, 2)

  consumidor Consumidor   @relation(fields: [consumidorId], references: [usuarioId], onDelete: Restrict)
  itens      ItemPedido[]
  pagamento  Pagamento?
  entrega    Entrega?

  @@index([consumidorId], map: "idx_pedido_consumidor")
  @@map("pedido")
}

model ItemPedido {
  pedidoId      String  @map("pedido_id") @db.Uuid
  produtoId     String  @map("produto_id") @db.Uuid
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@id([pedidoId, produtoId])
  @@index([produtoId], map: "idx_item_pedido_produto")
  @@map("item_pedido")
}

model Pagamento {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId String          @unique @map("pedido_id") @db.Uuid
  metodo   MetodoPagamento
  status   StatusPagamento @default(pendente)
  valor    Decimal         @db.Decimal(12, 2)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("pagamento")
}

model Entrega {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId       String        @unique @map("pedido_id") @db.Uuid
  status         StatusEntrega @default(aguardando)
  codigoRastreio String?       @map("codigo_rastreio") @db.VarChar(50)
  valorFrete     Decimal       @default(0) @map("valor_frete") @db.Decimal(10, 2)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("entrega")
}

// ---------- Avaliação ----------

model Avaliacao {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumidorId String   @map("consumidor_id") @db.Uuid
  artesaoId    String   @map("artesao_id") @db.Uuid
  nota         Int      @db.SmallInt
  comentario   String?
  data         DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date

  consumidor Consumidor @relation(fields: [consumidorId], references: [usuarioId], onDelete: Cascade)
  artesao    Artesao    @relation(fields: [artesaoId], references: [usuarioId], onDelete: Cascade)

  @@index([artesaoId], map: "idx_avaliacao_artesao")
  @@map("avaliacao")
}