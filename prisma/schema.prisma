generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Convenção: os nomes dos campos Prisma são IGUAIS aos do backend (src/models).
// No banco, colunas com mais de uma palavra usam snake_case via @map.
// Campos marcados com "só banco" existem no modelo físico mas ainda não no backend.

// ---------- Enums ----------

enum StatusCuradoria { // só banco
  pendente
  aprovado
  reprovado
}

enum StatusPedido { // igual ao STATUS_PEDIDO de models/Pedido.js
  pendente
  aprovado
  preparado
  enviado
  entregue
  cancelado
}

enum MetodoPagamento { // só banco
  pix
  cartaoCredito
  cartaoDebito
  boleto
}

enum StatusPagamento { // só banco
  pendente
  aprovado
  recusado
  estornado
}

enum StatusEntrega { // só banco
  aguardando
  emTransporte
  entregue
  extraviado
}

// ---------- User (base) e Artesao (herda de User) ----------

// Tabela "users" porque "user" é palavra reservada no Postgres.
model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String @db.VarChar(150)
  password String @db.VarChar(255) // guarda o hash bcrypt, nunca a senha pura
  email    String @unique @db.VarChar(255)
  cep      String @db.VarChar(9)

  artesao    Artesao?
  pedidos    Pedido[]
  carrinho   Carrinho?
  avaliacoes Avaliacao[]

  @@map("users")
}

// Herança: Artesao "é um" User (mesmo id, PK e FK ao mesmo tempo)
model Artesao {
  id          String  @id @db.Uuid
  cpf         String  @unique @db.VarChar(14)
  bio         String? @db.Text
  experiencia String? @db.Text
  telefone    String? @db.VarChar(20)

  // só banco (backend ainda não usa; todos opcionais ou com default)
  tecnica         String?         @db.VarChar(100)
  municipio       String?         @db.VarChar(100)
  statusCuradoria StatusCuradoria @default(pendente) @map("status_curadoria")

  user     User      @relation(fields: [id], references: [id], onDelete: Cascade)
  products Product[]

  @@map("artesao")
}

// Adm é independente de User no backend, então é uma tabela própria
model Adm {
  idAdm    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id_adm")
  username String @db.VarChar(150)
  password String @db.VarChar(255) // hash bcrypt
  email    String @unique @db.VarChar(255)

  @@map("adm")
}

// ---------- Catálogo ----------

// Única exceção de nome: no backend "categoria" é uma string em Product.
// Aqui continua uma tabela (integridade), e o service converte string <-> relação.
model Categoria {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome String @unique @db.VarChar(80)

  products Product[]

  @@map("categoria")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String   @db.VarChar(150)
  descricao   String?  @db.Text
  preco       Decimal  @db.Decimal(10, 2)
  estoque     Int      @default(0)
  ativo       Boolean  @default(true)
  fotos       String[] @default([])
  historia    String?  @db.Text
  artesaoId   String   @map("artesao_id") @db.Uuid
  categoriaId String   @map("categoria_id") @db.Uuid

  // só banco
  tecnica        String? @db.VarChar(100)
  materialOrigem String? @map("material_origem") @db.VarChar(150)

  artesao       Artesao       @relation(fields: [artesaoId], references: [id], onDelete: Restrict)
  categoria     Categoria     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  itensPedido   ItemPedido[]
  carrinhoItens CarrinhoItem[]
  avaliacoes    Avaliacao[]

  @@index([artesaoId], map: "idx_product_artesao")
  @@index([categoriaId], map: "idx_product_categoria")
  @@map("product")
}

// ---------- Pedido ----------

model Pedido {
  idPedido  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id_pedido")
  data      DateTime     @default(now()) @db.Timestamptz(6)
  cepPedido String       @map("cep_pedido") @db.VarChar(9)
  endereco  String       @default("") @db.VarChar(300)
  usuarioId String       @map("usuario_id") @db.Uuid
  status    StatusPedido @default(pendente)
  total     Decimal      @default(0) @db.Decimal(12, 2)
  // "concluido" não é coluna: é derivado (status === 'entregue')

  user      User         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  itens     ItemPedido[]
  pagamento Pagamento? // só banco
  entrega   Entrega? // só banco

  @@index([usuarioId], map: "idx_pedido_usuario")
  @@map("pedido")
}

model ItemPedido {
  idPedido      String  @map("id_pedido") @db.Uuid
  idProduto     String  @map("id_produto") @db.Uuid
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  // "subtotal" não é coluna: é precoUnitario * quantidade

  pedido  Pedido  @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)
  product Product @relation(fields: [idProduto], references: [id], onDelete: Restrict)

  @@id([idPedido, idProduto])
  @@index([idProduto], map: "idx_item_pedido_produto")
  @@map("item_pedido")
}

// ---------- Carrinho ----------

model Carrinho {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId    String   @unique @map("usuario_id") @db.Uuid // 1 carrinho por usuário
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  user  User           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens CarrinhoItem[]

  @@map("carrinho")
}

model CarrinhoItem {
  carrinhoId String @map("carrinho_id") @db.Uuid
  idProduto  String @map("id_produto") @db.Uuid
  quantidade Int

  carrinho Carrinho @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [idProduto], references: [id], onDelete: Cascade)

  @@id([carrinhoId, idProduto])
  @@index([idProduto], map: "idx_carrinho_item_produto")
  @@map("carrinho_item")
}

// ---------- Avaliação (por produto, como no backend) ----------

model Avaliacao {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produtoId  String   @map("produto_id") @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  nota       Int      @db.SmallInt
  comentario String?  @db.Text
  data       DateTime @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([produtoId], map: "idx_avaliacao_produto")
  @@index([usuarioId], map: "idx_avaliacao_usuario")
  @@map("avaliacao")
}

// ---------- Só banco (ainda sem equivalente no backend) ----------

model Pagamento {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idPedido String          @unique @map("id_pedido") @db.Uuid
  metodo   MetodoPagamento
  status   StatusPagamento @default(pendente)
  valor    Decimal         @db.Decimal(12, 2)

  pedido Pedido @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)

  @@map("pagamento")
}

model Entrega {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idPedido       String        @unique @map("id_pedido") @db.Uuid
  status         StatusEntrega @default(aguardando)
  codigoRastreio String?       @map("codigo_rastreio") @db.VarChar(50)
  valorFrete     Decimal       @default(0) @map("valor_frete") @db.Decimal(10, 2)

  pedido Pedido @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)

  @@map("entrega")
}