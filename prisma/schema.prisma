generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm]
}

// Convenção: os nomes dos campos Prisma são IGUAIS aos do backend (src/models).
// No banco, colunas com mais de uma palavra usam snake_case via @map.
// Campos marcados com "só banco" existem no modelo físico mas ainda não no backend.
//
// IDs: todas as chaves primárias são UUID gerados pelo Postgres (gen_random_uuid()).
//
// Restrições CHECK: o Prisma não as representa no schema. Elas ficam no SQL das
// migrations (procure "CHECK" em prisma/migrations). Não use `prisma db push`,
// porque ele não cria esses CHECKs; use sempre `prisma migrate`.
//   - preço, estoque, total, valores e frete >= 0
//   - quantidades > 0; nota entre 1 e 5
//   - cep no formato 00000-000 ou 00000000; cpf com 11 dígitos
//   - sessao: exatamente um dono (user_id ou adm_id), coerente com o papel

// ---------- Enums ----------

enum Papel {
  comprador
  artesao
  adm
}

enum StatusCuradoria {
  pendente
  aprovado
  reprovado
}

enum StatusPedido {
  pendente
  aprovado
  preparado
  enviado
  entregue
  cancelado
}

enum MetodoPagamento {
  pix
  cartaoCredito
  cartaoDebito
  boleto
}

enum StatusPagamento {
  pendente
  aprovado
  recusado
  estornado
}

enum StatusEntrega {
  aguardando
  emTransporte
  entregue
  extraviado
}

// ---------- User (base) e Artesao (herda de User) ----------

// Tabela "users" porque "user" é palavra reservada no Postgres.
// username e email são citext: a unicidade ignora maiúsculas/minúsculas,
// igual à comparação com toLowerCase() feita nos services.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique @db.Citext // login é feito por username
  password     String   @db.VarChar(255) // guarda o hash bcrypt, nunca a senha pura
  email        String   @unique @db.Citext
  cep          String   @db.VarChar(9)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  artesao    Artesao?
  pedidos    Pedido[]
  carrinho   Carrinho?
  avaliacoes Avaliacao[]
  sessoes    Sessao[]

  @@map("users")
}

// Herança: Artesao "é um" User (mesmo id, PK e FK ao mesmo tempo)
model Artesao {
  id          String  @id @db.Uuid
  cpf         String  @unique @db.Char(11) // só dígitos (o service normaliza)
  bio         String? @db.Text
  experiencia String? @db.Text
  telefone    String? @db.VarChar(20)

  // só banco (backend ainda não usa; todos opcionais ou com default)
  tecnica         String?         @db.VarChar(100)
  municipio       String?         @db.VarChar(100)
  statusCuradoria StatusCuradoria @default(pendente) @map("status_curadoria")

  user     User      @relation(fields: [id], references: [id], onDelete: Cascade)
  products Product[]

  @@map("artesao")
}

// Adm é independente de User no backend, então é uma tabela própria
model Adm {
  idAdm        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id_adm") @db.Uuid
  username     String   @unique @db.Citext
  password     String   @db.VarChar(255) // hash bcrypt
  email        String   @unique @db.Citext
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  sessoes Sessao[]

  @@map("adm")
}

// ---------- Sessão (tokens do AuthService) ----------

// Um token pertence a um User (comprador/artesão) OU a um Adm, nunca aos dois.
// O CHECK chk_sessao_dono na migration garante isso.
model Sessao {
  token    String   @id @db.VarChar(255)
  papel    Papel
  userId   String?  @map("user_id") @db.Uuid
  admId    String?  @map("adm_id") @db.Uuid
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  expiraEm DateTime @map("expira_em") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  adm  Adm?  @relation(fields: [admId], references: [idAdm], onDelete: Cascade)

  @@index([userId], map: "idx_sessao_user")
  @@index([admId], map: "idx_sessao_adm")
  @@index([expiraEm], map: "idx_sessao_expira")
  @@map("sessao")
}

// ---------- Catálogo ----------

// Única exceção de nome: no backend "categoria" é uma string em Product.
// Aqui continua uma tabela (integridade), e o service converte string <-> relação.
model Categoria {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome String @unique @db.VarChar(100) // mesmo limite da validação das rotas

  products Product[]

  @@map("categoria")
}

model Product {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String   @db.VarChar(150)
  descricao    String?  @db.Text
  preco        Decimal  @db.Decimal(10, 2)
  estoque      Int      @default(0)
  ativo        Boolean  @default(true)
  fotos        String[] @default([])
  historia     String?  @db.Text
  artesaoId    String?  @map("artesao_id") @db.Uuid // opcional, como na rota
  categoriaId  String?  @map("categoria_id") @db.Uuid // opcional: backend aceita categoria vazia
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  // só banco
  tecnica        String? @db.VarChar(100)
  materialOrigem String? @map("material_origem") @db.VarChar(150)

  artesao       Artesao?       @relation(fields: [artesaoId], references: [id], onDelete: Restrict)
  categoria     Categoria?     @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  itensPedido   ItemPedido[]
  carrinhoItens CarrinhoItem[]
  avaliacoes    Avaliacao[]

  @@index([artesaoId], map: "idx_product_artesao")
  @@index([categoriaId], map: "idx_product_categoria")
  @@index([nome(ops: raw("gin_trgm_ops"))], map: "idx_product_nome_trgm", type: Gin) // buscarPorNome ("contém")
  @@map("product")
}

// ---------- Pedido ----------

model Pedido {
  idPedido     String       @id @default(dbgenerated("gen_random_uuid()")) @map("id_pedido") @db.Uuid
  data         DateTime     @default(now()) @db.Timestamptz(6)
  cepPedido    String       @map("cep_pedido") @db.VarChar(9)
  endereco     String       @default("") @db.VarChar(300)
  usuarioId    String?      @map("usuario_id") @db.Uuid // opcional, como na rota
  status       StatusPedido @default(pendente)
  // Gravado à parte: PUT /pedidos/:id altera "concluido" sem mexer no status.
  concluido    Boolean      @default(false)
  // Cópia do total calculado pelos itens; o service deve regravar a cada mudança.
  total        Decimal      @default(0) @db.Decimal(12, 2)
  atualizadoEm DateTime     @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  user      User?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  itens     ItemPedido[]
  pagamento Pagamento? // só banco
  entrega   Entrega? // só banco

  @@index([usuarioId], map: "idx_pedido_usuario")
  @@index([status], map: "idx_pedido_status")
  @@map("pedido")
}

model ItemPedido {
  idPedido      String  @map("id_pedido") @db.Uuid
  idProduto     String  @map("id_produto") @db.Uuid
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  // "subtotal" não é coluna: é precoUnitario * quantidade

  pedido  Pedido  @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)
  product Product @relation(fields: [idProduto], references: [id], onDelete: Restrict)

  @@id([idPedido, idProduto])
  @@index([idProduto], map: "idx_item_pedido_produto")
  @@map("item_pedido")
}

// ---------- Carrinho ----------

model Carrinho {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId    String   @unique @map("usuario_id") @db.Uuid // 1 carrinho por usuário
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  user  User           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens CarrinhoItem[]

  @@map("carrinho")
}

model CarrinhoItem {
  carrinhoId String @map("carrinho_id") @db.Uuid
  idProduto  String @map("id_produto") @db.Uuid
  quantidade Int

  carrinho Carrinho @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [idProduto], references: [id], onDelete: Cascade)

  @@id([carrinhoId, idProduto])
  @@index([idProduto], map: "idx_carrinho_item_produto")
  @@map("carrinho_item")
}

// ---------- Avaliação (por produto, como no backend) ----------

model Avaliacao {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produtoId  String   @map("produto_id") @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  nota       Int      @db.SmallInt
  comentario String?  @db.Text
  data       DateTime @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // 1 avaliação por usuário por produto (o AvaliacaoService já exige isso).
  // O índice único também serve às buscas por produto_id.
  @@unique([produtoId, usuarioId], map: "uq_avaliacao_produto_usuario")
  @@index([usuarioId], map: "idx_avaliacao_usuario")
  @@map("avaliacao")
}

// ---------- Só banco (ainda sem equivalente no backend) ----------

model Pagamento {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idPedido    String          @unique @map("id_pedido") @db.Uuid
  metodo      MetodoPagamento
  status      StatusPagamento @default(pendente)
  valor       Decimal         @db.Decimal(12, 2)
  transacaoId String?         @unique @map("transacao_id") @db.VarChar(100) // id no provedor de pagamento
  criadoEm    DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  pagoEm      DateTime?       @map("pago_em") @db.Timestamptz(6)

  pedido Pedido @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)

  @@map("pagamento")
}

model Entrega {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idPedido       String        @unique @map("id_pedido") @db.Uuid
  status         StatusEntrega @default(aguardando)
  codigoRastreio String?       @map("codigo_rastreio") @db.VarChar(50)
  valorFrete     Decimal       @default(0) @map("valor_frete") @db.Decimal(10, 2)
  enviadoEm      DateTime?     @map("enviado_em") @db.Timestamptz(6)
  entregueEm     DateTime?     @map("entregue_em") @db.Timestamptz(6)

  pedido Pedido @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)

  @@map("entrega")
}
