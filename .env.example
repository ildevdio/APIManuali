# O arquivo .env NÃO deve ser commitado.
# exemplo de o que deve ser colocado no arquivo .env
# substitua o SUA_SENHA com a senha do seu postgres

DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/manuali?schema=public"
PORT=3001
JWT_SECRET="dev-secret-manuali-compat"

# IA (OpenAI-compatible / Ollama) - usado pelos endpoints /api/recomendacoes/ia/*
AI_API_KEY="ollama"
AI_BASE_URL="http://localhost:11434/v1"
AI_MODEL="llama3.2"